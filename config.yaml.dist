app_name: "cronado"
log:
  level: "info"
  format: "text"
cron_label_prefix: "cronado"
# Minimum allowed interval for @every schedules (prevents DoS via rapid scheduling)
min_schedule_interval: "1m"
# Maximum allowed timeout for job execution
max_timeout: "12h"
# How long to wait for running jobs when cronado stops; keep it below Docker's
# stop grace period (10s by default, stop_grace_period in Compose)
shutdown_timeout: "8s"
daemon_watcher:
  enabled: true
  timeout_seconds: 5
server:
  port: "8080"
  host: "127.0.0.1"
  # Optional Bearer token for API and metrics endpoint authentication.
  # When empty, authentication is disabled (default).
  # Set via CRONADO_SERVER_API_TOKEN environment variable in production.
  api_token: ""
ping:
  # Allow ping_url labels to reach private and loopback addresses,
  # e.g. a self-hosted Healthchecks instance. Only enable if label authors are trusted.
  allow_private_networks: false
notify:
  interval_seconds: 3600
  # Add the end of the command output to failure notifications.
  include_output: true
  email:
    enabled: false
    smtp_host: ""
    smtp_port: 587
    username: ""
    password: ""
    from: ""
    to: []
    # Require TLS for SMTP connections. Set to false only for local/test SMTP servers.
    require_tls: true
  ntfy:
    enabled: false
    server: "https://ntfy.sh"
    topic: ""
    token: ""
  webhook:
    enabled: false
    url: ""
    # generic, slack, discord or gotify
    format: "generic"
metrics:
  enabled: true
  endpoint: "/metrics"
# Cron jobs for containers whose labels you cannot change. Same properties
# as the labels; enabled defaults to true. Read at startup only.
