FROM alpine:3

WORKDIR /opt

RUN apk upgrade --no-cache && apk add --no-cache ca-certificates tzdata

RUN addgroup -S app \
    && adduser -S -G app app \
    && addgroup app ping

USER app

EXPOSE 8080

ENV GIN_MODE=release

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD ["./cronado", "healthcheck"]

ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/cronado ./

LABEL org.opencontainers.image.source="https://github.com/teqneers/cronado"
LABEL org.opencontainers.image.description="Lightweight cron job scheduler for Docker containers"
LABEL org.opencontainers.image.licenses="MIT"

CMD ["./cronado", "cron"]
